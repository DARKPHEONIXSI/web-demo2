{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.10",
  "typeCheckingMode": "basic",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": false,
  "exclude": [
    ".venv",
    "__pycache__",
    ".pytest_cache",
    ".ruff_cache",
    "uploads",
    "database_backup.db",
    "cloudflared.exe"
  ],
  "include": [
    "*.py"
  ]
}
