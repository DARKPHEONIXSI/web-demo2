FLASK_ENV=development
FLASK_DEBUG=0
FLASK_RUN_HOST=127.0.0.1

SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
ADMIN_USER=replace-with-admin-username
ADMIN_PASS_HASH=replace-with-werkzeug-password-hash

DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/replace-database
REDIS_URL=redis://replace-host:6379/0

RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
PAYTM_MERCHANT_ID=replace-with-paytm-merchant-id
PAYTM_MERCHANT_KEY=replace-with-paytm-merchant-key

GOOGLE_CLIENT_ID=replace-with-google-client-id
SENDGRID_API_KEY=replace-with-sendgrid-api-key
SENDGRID_FROM_EMAIL=replace-with-sender@example.com
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=replace-with-twilio-number
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

ALLOW_SIMULATED_GOOGLE_AUTH=0
ALLOW_SQLITE_PRODUCTION=0
